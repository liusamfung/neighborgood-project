EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo para quien instala la app en un iPhone con una cuenta personal (gratuita) de Apple.
# NUNCA afecta a Android ni a las builds de EAS, tenga el valor que tenga.
#   1         = quita el permiso de push remoto de iOS. Así Xcode puede firmar la app y la instalas en tu
#               iPhone, pero ese iPhone no recibe push remotas (las notificaciones locales sí funcionan).
#   0 o vacío = no hace nada: iOS conserva el push remoto. Es el valor por defecto (Android, cuenta de pago, EAS).
# Después de cambiarlo, regenera ios/:  npx expo prebuild --platform ios --clean
NEIGHBORGOOD_SIN_PUSH_ONLY_IPHONE=
