EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo: recorre un rol sin Supabase (directiva, residente o guardia).
# Se elimina cuando exista el inicio de sesión real.
EXPO_PUBLIC_ROL_DEV=

# Solo iOS, solo si firmas con una cuenta personal (gratuita) de Apple: quita el permiso de push
# remoto para poder instalar en tu iPhone (tu teléfono no recibirá push remotas; las locales sí).
# Déjalo vacío o bórralo si usas Android o una cuenta de pago. Después: npx expo prebuild --platform ios --clean
NEIGHBORGOOD_SIN_PUSH=
