@startuml Diagrama4_3_AtencionAlerta
title Diagrama 4.3 — Atención de la alerta (RF27)

hide footbox
autonumber

actor "Residente\nemisor" as RES
actor "Directiva /\nSeguridad" as ADM
participant "App del emisor" as APPE
participant "App receptora" as APPR

box "Supabase" #F1EFE8
    database "Postgres" as DB
    participant "Realtime" as RT
end box

ADM -> APPR : marcar "estoy en camino" o "alerta atendida" (RF27)
activate APPR
APPR -> DB : registrar la respuesta en la bitácora; un trigger actualiza el estado de la alerta (RF27)
activate DB
DB --> APPR : estado actualizado
deactivate DB
APPR -> RT : publicar cambio de estado (RF27)
activate RT
RT --> APPE : notificar el estado al emisor (RF27)
deactivate RT
APPE --> RES : mostrar que la alerta está siendo atendida (RF27)
deactivate APPR
@enduml
