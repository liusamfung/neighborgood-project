@startuml Diagrama2_4_ResultadosHistorial
title Diagrama 2.4 — Resultados e historial (RF11, RF12)

hide footbox
autonumber

actor "Residente" as RES
participant "App móvil" as APP

box "Supabase" #F1EFE8
    database "Postgres" as DB
    participant "Realtime" as RT
end box

activate APP
alt resultados configurados en tiempo real
    APP -> RT : suscribirse al canal de la encuesta (RF12)
    activate RT
    RT --> APP : conteo actualizado de votos (RF12)
    deactivate RT
    APP --> RES : resultados en vivo
else resultados visibles al cierre
    APP -> DB : consultar resultados finales (RF12)
    activate DB
    DB --> APP : conteo final
    deactivate DB
    APP --> RES : resultados de la encuesta cerrada
end

RES -> APP : consultar historial de avisos y encuestas (RF11)
APP -> DB : recuperar registros anteriores (RF11)
activate DB
DB --> APP : historial
deactivate DB
APP --> RES : mostrar historial
deactivate APP
@enduml
