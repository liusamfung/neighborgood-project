@startuml
title NeighborGood · Flujo de la Directiva
skinparam shadowing false
skinparam defaultFontName Inter
skinparam ActivityBackgroundColor #E6F4F1
skinparam ActivityBorderColor #0F766E
skinparam ArrowColor #0F766E
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B

start
:P1 Login\n(correo o Google);
:La app detecta el rol "Directiva"\ny abre su panel;
:P12 Panel de resumen\n(alertas, incidencias, encuestas abiertas);

repeat
  switch (¿Qué hace la directiva?)
  case (Publicar un aviso)
    :P13 Crear aviso;
    :Escribir título y descripción,\nelegir la categoría y la vigencia;
    :Adjuntar una imagen (opcional);
    :Elegir a qué sectores va dirigido\n(o todo el condominio);
    :Publicar;
    :Los residentes de esos sectores\nreciben una notificación push;
  case (Crear una encuesta)
    :P14 Crear encuesta;
    :Agregar preguntas y opciones\n(una o varias respuestas);
    :Elegir categoría, sectores, apertura y cierre,\nsi es obligatoria y si muestra resultados en vivo;
    :Publicar;
    :Los residentes votan\n(un voto por unidad);
    :P14b Ver resultados de la encuesta;
  case (Gestionar incidencias)
    :P15 Lista de incidencias;
    :Abrir una incidencia\n(descripción, ubicación y fotos);
    :Cambiar el estado\nPendiente → En atención → Resuelto;
    note right: El residente que la reportó\nrecibe el nuevo estado
    :Ver la gráfica mensual de incidencias;
  case (Administración)
    :Dar de alta o de baja a un residente\nhabilitado y asociarlo a su unidad;
    :Consultar el historial de alertas\n(fecha, tipo, unidad y estado);
    note right: Pantallas descritas en DISENO.md,\nsin mockup todavía
  endswitch
repeat while (¿Sigue usando la app?) is (sí) not (no)

:Cerrar sesión;
stop
@enduml
