@startuml
title NeighborGood · Flujo del Residente
skinparam shadowing false
skinparam defaultFontName Inter
skinparam ActivityBackgroundColor #E6F4F1
skinparam ActivityBorderColor #0F766E
skinparam ArrowColor #0F766E
skinparam NoteBackgroundColor #FEF3C7
skinparam NoteBorderColor #F59E0B

start
:P1 Login / registro\n(correo o Google);
if (¿Tu correo está habilitado\npor la directiva?) then (sí)
  :Sesión iniciada;
else (no)
  :Mensaje: "Tu correo no está habilitado.\nContacta a la directiva";
  stop
endif

:P2 Inicio\n(botón de pánico, aviso, encuesta, visita);

repeat
  switch (¿Qué quiere hacer el residente?)
  case (Emergencia)
    :P2 Tocar "Enviar alerta de emergencia";
    :P3 Elegir el tipo de alerta\n(Médica / Incendio / Seguridad);
    :Confirmar la alerta;
    note right: Máximo 3 toques desde Inicio (RNF4)
    :P3b Alerta enviada\ncon la ubicación de su departamento;
    :Su teléfono vibra y suena;
    note right: El guardia, la directiva y los vecinos\ndel sector la reciben en tiempo real
    :Ve el estado de la alerta:\nActiva → En camino → Atendida;
  case (Avisos)
    :P4 Lista de avisos;
    :Filtrar por categoría;
    :Detalle del aviso;
    :Consultar el historial\nde avisos y encuestas pasadas;
  case (Encuesta)
    :P5 Encuesta\n(con insignia "Obligatoria" si es de prioridad alta);
    if (¿Tu unidad ya votó?) then (sí)
      :Mostrar "Tu unidad ya votó";
    else (no)
      :Elegir opción(es) y votar;
      :Voto registrado\n(un voto por unidad);
    endif
    :Ver resultados\n(en vivo o al cierre);
  case (Visitas)
    :P6 Visitas;
    :Crear pase con nombre del invitado,\nfecha y hora estimada;
    :Mostrar el QR del pase;
    note right: Vale solo el día de la visita\n(hasta las 23:59)
    :Compartir el QR con la visita;
    if (¿Anular el pase antes de usarlo?) then (sí)
      :Pase anulado;
    else (no)
      :Recibir una notificación\ncuando la visita ingresa;
    endif
  case (Incidencias)
    :P7 Reportar incidencia;
    :Describir, adjuntar de 1 a 3 fotos\ny confirmar la ubicación\n(por defecto, su departamento);
    :Incidencia enviada\nEstado: Pendiente;
    :Seguir el estado:\nPendiente → En atención → Resuelto;
  case (Perfil)
    :P8 Perfil;
    :Agregar, editar o eliminar contactos\nde emergencia (hasta 3);
  endswitch
repeat while (¿Sigue usando la app?) is (sí) not (no)

:Cerrar sesión;
stop
@enduml
