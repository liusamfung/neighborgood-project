{
  "expo": {
    "name": "NeighborGood",
    "slug": "neighborgood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neighborgood",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.liusamfung.neighborgood"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002B29",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.liusamfung.neighborgood",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "./plugins/quitar-push-entitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002B29",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NeighborGood usa la cámara para escanear el código QR del pase de visita y para fotografiar incidencias.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NeighborGood accede a tus fotos para adjuntarlas a los avisos y a las incidencias.",
          "cameraPermission": "NeighborGood usa la cámara para escanear el código QR del pase de visita y para fotografiar incidencias.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7673406c-1cbf-4ed6-955f-c547d5277b2b"
      }
    },
    "owner": "neighborgood"
  }
}
